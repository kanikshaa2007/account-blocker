# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== Stage0: India Viral Monitoring (all optional in Stage0, warn-only) =====
# Neo4j persistent spread-graph (MiroFish uses Zep Cloud by default; Neo4j is additive)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
# Social connectors - official APIs only (no password scraping)
X_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_API_KEY=
# Ground truth - PIB Fact Check / official sources via Web-Writer (public pages only)
PIB_FACTCHECK_RSS_URL=https://factcheck.pib.gov.in/feed/
# Safety: Stage0 freezes action to report-only; never auto-block third-party accounts
ACTION_MODE=report_only
# ===== Stage8: live social feeds (keyless public endpoints) =====
REDDIT_SUBS=india
# YouTube channel IDs or @handle/page URLs (handles resolved at ingest)
YOUTUBE_CHANNELS=UCGDQNvybfDDeGTf4GtigXaw
# ===== Stage3: Realtime (near-real-time polling + free push) =====
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=change_me
# Poll intervals (seconds) - RSS free/fast, APIs slower to save quota
RSS_INTERVAL_S=180
X_INTERVAL_S=300
INSTAGRAM_INTERVAL_S=420
YOUTUBE_INTERVAL_S=600
